{
  "name": "next-tongue-vscode",
  "displayName": "next-tongue",
  "description": "Inline previews, diagnostics, go-to-message, and hover for next-tongue",
  "version": "0.0.0",
  "publisher": "next-tongue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrLouisWright/next-tongue.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/MrLouisWright/next-tongue/blob/main/docs/vscode.md",
  "bugs": {
    "url": "https://github.com/MrLouisWright/next-tongue/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other", "Programming Languages"],
  "keywords": ["i18n", "l10n", "next.js", "icu", "next-tongue"],
  "activationEvents": [
    "workspaceContains:**/.tongue/manifest.json",
    "workspaceContains:**/tongue.config.ts",
    "workspaceContains:**/tongue.config.mjs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "next-tongue.reloadManifest",
        "title": "next-tongue: Reload manifest"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "pnpm run build && vsce package --no-dependencies",
    "publish:vsce": "pnpm run build && vsce publish --no-dependencies",
    "publish:ovsx": "pnpm run build && ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.2",
    "ovsx": "^0.10.1",
    "typescript": "^5.9.3"
  }
}

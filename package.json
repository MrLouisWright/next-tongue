{
  "name": "next-tongue-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && pnpm --filter next-tongue run typecheck",
    "lint": "eslint .",
    "changeset": "changeset",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter next-tongue run check:deps"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "esbuild": "^0.25.10",
    "vitest": "^3.2.4"
  }
}

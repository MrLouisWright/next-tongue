{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "skipLibCheck": true,
    "paths": {
      "#tongue/*": ["./.tongue/*"]
    }
  },
  "include": ["src/**/*.ts", ".tongue/types.d.ts"]
}
